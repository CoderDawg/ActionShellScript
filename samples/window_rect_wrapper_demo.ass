// Windows-only demo for the GetWindowRect wrapper builtin.
// It returns a Rect struct directly from the script-facing builtin.

Struct Rect
    Left As Int32
    Top As Int32
    Right As Int32
    Bottom As Int32
End Struct

Declare Func GetDesktopWindow Lib "user32.dll" StdCall () As Ptr

Dim desktop = GetDesktopWindow()
Dim window_rect = GetWindowRect(desktop)

WriteLn("GetWindowRect")
WriteLn("Left=" & window_rect.Left)
WriteLn("Top=" & window_rect.Top)
WriteLn("Right=" & window_rect.Right)
WriteLn("Bottom=" & window_rect.Bottom)
