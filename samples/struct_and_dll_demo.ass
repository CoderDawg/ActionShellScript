// Windows-only demo for the struct and DLL interop surface.
// It shows typed fields, struct constructors, Declare Func, Declare Sub,
// ByRef string buffers, and a small Win32 call chain.

Struct Point
    X As Int32
    Y As Int32
End Struct

Struct Rect
    Left As Int32
    Top As Int32
    Right As Int32
    Bottom As Int32
End Struct

Declare Func GetDesktopWindow Lib "user32.dll" StdCall () As Ptr
Declare Func GetWindowRect Lib "user32.dll" StdCall (hWnd As Ptr, ByRef rect As Rect) As Bool
Declare Func GetModuleFileNameW Lib "kernel32.dll" Default (hModule As Ptr, ByRef fileName As String(260), nSize As UInt32) As UInt32
Declare Sub OutputDebugStringW Lib "kernel32.dll" Alias "OutputDebugStringW" Default (text As String)

Dim origin = Point(0, 0)
Dim size = Point(640, 480)
Dim rect = Rect(0, 0, 0, 0)
Dim desktop = GetDesktopWindow()
Dim rect_ok = GetWindowRect(desktop, rect)
Dim module_path = ""
Dim module_path_length = GetModuleFileNameW(0, module_path, 260)

WriteLn(origin.X)
WriteLn(origin.Y)
WriteLn(size.X)
WriteLn(size.Y)
WriteLn(rect_ok)
WriteLn(rect.Right - rect.Left)
WriteLn(rect.Bottom - rect.Top)
WriteLn(module_path_length)
WriteLn(module_path)
OutputDebugStringW(module_path)
